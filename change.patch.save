 void closeDoor2()
 {
   if (state2 != 2) {
     state2 = 2;
     myservo2.attach(SERVOPIN2);
+    myservo3.attach(SERVOPIN3);
 
     if (ANGLEOPEN2 >= ANGLECLOSE2) {
       for (int pos = ANGLEOPEN2; pos >= ANGLECLOSE2; pos -= 1) {
         myservo2.write(pos);
+        myservo3.write(pos);
         delay(delayclose2);
       }
     } else {
       for (int pos = ANGLEOPEN2; pos <= ANGLECLOSE2; pos += 1) {
         myservo2.write(pos);
+        myservo3.write(pos);
         delay(delayclose2);
       }
     }
     myservo2.detach();
+    myservo3.detach();
   }
 }
 
 void noiseDoor2()
 {
 
   state2 = 0;
   myservo2.attach(SERVOPIN2);
+  myservo3.attach(SERVOPIN3);
 
