 void turnLedOn()
 {
   digitalWrite(LED, HIGH);
   LoadCell.tare();
   scaleOn = false;
 }
 
 void turnLedOff()
 {
   digitalWrite(LED, LOW);
   LoadCell.tare();
 }
 
 
 
 
 void tempAndScale()
 {
   float t = sht31.readTemperature();
   float h = sht31.readHumidity();
   Serial.print("Temperature;"); Serial.print(t); Serial.print("\t");

